# Python
__pycache__/
*.py[cod]
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/

# Experiment artifacts (large / local caches)
/artifacts/*
!/artifacts/README.md
!/artifacts/ccpp/
!/artifacts/ccpp/.gitkeep

# Local datasets
data/raw/
data/interim/
# Processed data can be committed selectively if small; ignore by default
data/processed/
!data/README.md

# Results are generated outputs; keep only placeholders unless explicitly
# unignored for a final report artifact later.
/results/*
!/results/README.md
!/results/.gitkeep
!/results/ccpp/
!/results/ccpp/.gitkeep

# Logs
*.log

# Local research notes and large/private documentation sources
docs/research_log.md
docs/meetings/
docs/references/
course-docs/

# Local agent state and tool-specific settings
.claude/
.codex/

# Packaging metadata
*.egg-info/

# Write up subrepo
msc-writeup/

papers/
