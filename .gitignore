# Python
__pycache__/
*.py[cod]
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/

# Experiment artifacts (large / local caches)
/artifacts/*
!/artifacts/README.md
!/artifacts/ccpp/
!/artifacts/ccpp/.gitkeep

# Local datasets
data/raw/
data/interim/
# Processed data can be committed selectively if small; ignore by default
data/processed/
!data/README.md

# Results are generated outputs; keep only placeholders unless explicitly
# unignored for a final report artifact later.
/results/*
!/results/README.md
!/results/.gitkeep
!/results/ccpp/
!/results/ccpp/.gitkeep

# Logs
*.log

# Local editor config (not part of the research artefact)
?GENTS.md
CLAUDE.md

# All documentation is local-only. NEVER add exceptions for docs/, and never
# add, stage, or commit any file beneath it.
docs/
course-docs/

# Agent instructions and workflows are always local-only. NEVER add negation
# rules for these paths or add, stage, or commit them to Git.
AGENTS.md
CLAUDE.md
.claude/
.codex/

# Packaging metadata
*.egg-info/

# Write up subrepo
msc-writeup/

papers/
