# Python
__pycache__/
*.py[cod]
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/

# Experiment artifacts (large / local caches)
/artifacts/*
!/artifacts/ccpp/
!/artifacts/ccpp/.gitkeep

# Local datasets
data/raw/
data/interim/
# Processed data can be committed selectively if small; ignore by default
data/processed/

# Results are generated outputs; keep only placeholders unless explicitly
# unignored for a final report artifact later.
/results/*
!/results/.gitkeep
!/results/ccpp/
!/results/ccpp/.gitkeep

# Logs
*.log

# Local assistant/editor config (not part of the research artefact)
CLAUDE.md
docs/
course-docs/
.claude/

# Packaging metadata
*.egg-info/

# Write up subrepo
msc-writeup/

papers/
