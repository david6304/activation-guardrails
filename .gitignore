# Python
__pycache__/
*.py[cod]
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/

# Experiment artifacts (large / local caches)
/artifacts/*
!/artifacts/README.md
!/artifacts/ccpp/
!/artifacts/ccpp/.gitkeep

# Local datasets
data/raw/
data/interim/
# Processed data can be committed selectively if small; ignore by default
data/processed/
!data/README.md

# Results are generated outputs; keep only placeholders unless explicitly
# unignored for a final report artifact later.
/results/*
!/results/README.md
!/results/.gitkeep
!/results/ccpp/
!/results/ccpp/.gitkeep

# Logs
*.log

# Local editor config (not part of the research artefact)
?GENTS.md
CLAUDE.md
# Track the lightweight scaffold docs; keep old/private notes local.
docs/*
!docs/CURRENT_STATE.md
!docs/PROJECT_PLAN.md
!docs/WORKFLOW.md
!docs/CLUSTER.md
!docs/ccpp_reproduction_matrix.md
!docs/matched_benign_prompt_spec.md
docs/research_log.md
docs/meetings/
docs/references/
course-docs/
.claude/

# Packaging metadata
*.egg-info/

# Write up subrepo
msc-writeup/

papers/
